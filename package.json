{
  "name": "portal-ecossistema",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "node scripts/prepare-map.mjs && next dev",
    "build": "node scripts/prepare-map.mjs && next build --webpack && node scripts/prepare-runtime.mjs",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:import": "node --env-file-if-exists=.env --experimental-strip-types scripts/import-data.mjs",
    "db:backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "test": "node scripts/prepare-map.mjs && node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:integration": "node tests/http-flow.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
